# Custom ComputeClass for the OpenClaw gVisor workers. GKE auto-creates and
# autoscales the node pool (n2d-standard-8, up to seven workers per node); this is the
# supported way to back a standby CapacityBuffer on a Standard cluster.
apiVersion: cloud.google.com/v1
kind: ComputeClass
metadata:
  name: openclaw-workers
spec:
  priorities:
  - machineType: n2d-standard-8
  nodePoolAutoCreation:
    enabled: true
  nodePoolConfig:
    serviceAccount: ${NODE_SA}
  whenUnsatisfiable: ScaleUpAnyway
