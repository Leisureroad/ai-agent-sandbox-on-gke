apiVersion: v1
kind: Namespace
metadata:
  name: openclaw
  labels:
    # Opens the network path to ate-api-server (api.ate-system.svc:443).
    ate.dev/api-access: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: openclaw-gateway
  namespace: openclaw
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: openclaw-gateway-config
  namespace: openclaw
data:
  openclaw.json: |
    {
      "plugins": {
        "allow": ["substrate", "feishu"],
        "entries": {
          "substrate": {
            "enabled": true,
            "config": {
              "role": "gateway",
              "atespace": "openclaw-demo",
              "template": "${TEMPLATE_NAME}",
              "idleTimeoutSeconds": ${IDLE_TIMEOUT_SECONDS},
              "idlePollMs": 1000,
              "actorToken": "${OPENCLAW_GATEWAY_TOKEN}",
              "replyPrefix": "🤖 ",
              "provisioner": "kubectl-ate",
              "kubectlAtePath": "/usr/local/bin/kubectl-ate",
              "ateapiAddress": "api.ate-system.svc:443"
            }
          }
        }
      },
      "acp": { "enabled": true, "backend": "substrate" },
      "agents": { "defaults": { "model": "google/gemini-3-flash-preview" } },
      "cron": { "enabled": false },
      "session": { "dmScope": "per-channel-peer" },
      "bindings": ${FEISHU_BINDINGS},
      "gateway": {
        "mode": "local",
        "port": 18789,
        "bind": "lan",
        "controlUi": { "enabled": true, "allowedOrigins": ["http://localhost:18789"] },
        "http": { "endpoints": { "chatCompletions": { "enabled": true } } },
        "auth": { "mode": "token" }
      },
      "channels": {
        "feishu": {
          "enabled": ${FEISHU_ENABLED},
          "domain": "${FEISHU_DOMAIN}",
          "connectionMode": "websocket",
          "appId": "${FEISHU_APP_ID}",
          "appSecret": "${FEISHU_APP_SECRET}",
          "dmPolicy": "open",
          "allowFrom": ["*"],
          "groupPolicy": "open",
          "requireMention": true,
          "groupSessionScope": "group",
          "streaming": { "mode": "off" }
        }
      }
    }
  egress-policy.yaml: |
    rules:
    - tls_passthrough:
        hostnames:
        - generativelanguage.googleapis.com
        ports:
          numbers: [443]
  envoy.yaml: |
    # Local plain-HTTP listener for the gateway, originating SPIFFE mTLS to
    # atenet-router (the only way into actors on Substrate v1.0).
    admin:
      address: { socket_address: { address: 127.0.0.1, port_value: 15000 } }
    static_resources:
      listeners:
      - name: router_egress
        address: { socket_address: { address: 127.0.0.1, port_value: 8080 } }
        filter_chains:
        - filters:
          - name: envoy.filters.network.http_connection_manager
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
              stat_prefix: router_egress
              stream_idle_timeout: 0s
              request_timeout: 0s
              route_config:
                virtual_hosts:
                - name: all
                  domains: ["*"]
                  routes:
                  - match: { prefix: "/" }
                    route: { cluster: atenet_router, timeout: 0s, idle_timeout: 600s }
                    # OpenClaw (actor) requires proxy client attribution: give it a
                    # well-formed X-Forwarded-For naming the gateway pod.
                    request_headers_to_add:
                    - header: { key: x-forwarded-for, value: "%ENVIRONMENT(POD_IP)%" }
                      append_action: OVERWRITE_IF_EXISTS_OR_ADD
              http_filters:
              - name: envoy.filters.http.router
                typed_config:
                  "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
      clusters:
      - name: atenet_router
        type: STRICT_DNS
        connect_timeout: 5s
        load_assignment:
          cluster_name: atenet_router
          endpoints:
          - lb_endpoints:
            - endpoint:
                address: { socket_address: { address: atenet-router.ate-system.svc.cluster.local, port_value: 443 } }
        transport_socket:
          name: envoy.transport_sockets.tls
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
            sni: atenet-router.ate-system.svc
            common_tls_context:
              tls_certificates:
              - certificate_chain: { filename: /run/router-client/credential-bundle.pem }
                private_key: { filename: /run/router-client/credential-bundle.pem }
                watched_directory: { path: /run/router-client }
              validation_context:
                trusted_ca: { filename: /run/router-client/router-ca.pem }
                watched_directory: { path: /run/router-client }
                match_typed_subject_alt_names:
                - san_type: DNS
                  matcher: { exact: atenet-router.ate-system.svc }
---
apiVersion: v1
kind: Service
metadata:
  name: openclaw-gateway
  namespace: openclaw
spec:
  selector:
    app: openclaw-gateway
  ports:
  - name: gateway
    port: 18789
    targetPort: 18789
  - name: observer
    port: 18790
    targetPort: 18790
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: openclaw-gateway-pvc
  namespace: openclaw
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openclaw-gateway
  namespace: openclaw
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: openclaw-gateway }
  template:
    metadata:
      labels: { app: openclaw-gateway }
      annotations:
        config-hash: "${CONFIG_HASH}"
    spec:
      serviceAccountName: openclaw-gateway
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile: { type: RuntimeDefault }
      initContainers:
      - name: config-and-plugin-init
        image: ${GATEWAY_IMAGE}
        command: ["sh", "-c"]
        args:
        - |
          set -x
          mkdir -p /home/node/state/.openclaw /home/node/state/.tmp
          chmod 700 /home/node/state/.tmp
          node /app/openclaw.mjs plugins install /app/extensions/substrate --force --accept-capabilities || true
          [ -d /home/node/state/.openclaw/extensions/feishu ] || node /app/openclaw.mjs plugins install @openclaw/feishu@2026.11.2 --accept-capabilities || \
            node /app/openclaw.mjs plugins install clawhub:@openclaw/feishu@2026.11.2 --accept-capabilities || true
          cp /config/openclaw.json /home/node/state/.openclaw/openclaw.json
          node /app/openclaw.mjs plugins install /app/extensions/substrate --force --accept-capabilities
          node /app/openclaw.mjs doctor --fix || true
        env:
        - { name: HOME, value: /home/node/state }
        - { name: OPENCLAW_CONFIG_DIR, value: /home/node/state/.openclaw }
        envFrom:
        - secretRef: { name: openclaw-secrets }
        - secretRef: { name: openclaw-feishu, optional: true }
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities: { drop: ["ALL"] }
        resources:
          limits: { memory: 2Gi, cpu: "1" }
        volumeMounts:
        - { name: openclaw-home, mountPath: /home/node/state }
        - { name: config, mountPath: /config, readOnly: true }
        - { name: cache-volume, mountPath: /home/node/state/.cache }
      containers:
      - name: gateway
        image: ${GATEWAY_IMAGE}
        command: ["node", "/app/openclaw.mjs", "gateway", "--bind", "lan", "--port", "18789"]
        ports:
        - { name: gateway, containerPort: 18789 }
        - { name: observer, containerPort: 18790 }
        env:
        - { name: HOME, value: /home/node/state }
        - { name: OPENCLAW_CONFIG_DIR, value: /home/node/state/.openclaw }
        - { name: NODE_ENV, value: production }
        - { name: ATE_ENDPOINT, value: "api.ate-system.svc:443" }
        - { name: ATE_TOKEN_FILE, value: /var/run/ate/token }
        - { name: EGRESS_POLICY_FILE, value: /config/egress-policy.yaml }
        - { name: ROUTER_URL, value: "http://127.0.0.1:8080" }
        - { name: SUBSTRATE_OBSERVER_PORT, value: "18790" }
        envFrom:
        - secretRef: { name: openclaw-secrets }
        - secretRef: { name: openclaw-feishu, optional: true }
        resources:
          requests: { memory: 768Mi, cpu: 200m }
          limits: { memory: 2Gi, cpu: "1" }
        readinessProbe:
          exec: { command: ["sh", "-c", "curl -sf -m 8 http://127.0.0.1:18789/readyz"] }
          initialDelaySeconds: 20
          periodSeconds: 10
          timeoutSeconds: 8
          failureThreshold: 30
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities: { drop: ["ALL"] }
        volumeMounts:
        - { name: openclaw-home, mountPath: /home/node/state }
        - { name: cache-volume, mountPath: /home/node/state/.cache }
        - { name: config, mountPath: /config, readOnly: true }
        - { name: ate-api, mountPath: /var/run/ate, readOnly: true }
      - name: router-proxy
        image: ${ENVOY_IMAGE}
        args: ["-c", "/config/envoy.yaml", "--log-level", "warn"]
        env:
        - name: POD_IP
          valueFrom: { fieldRef: { fieldPath: status.podIP } }
        resources:
          requests: { memory: 64Mi, cpu: 50m }
          limits: { memory: 256Mi }
        securityContext:
          allowPrivilegeEscalation: false
          capabilities: { drop: ["ALL"] }
        volumeMounts:
        - { name: config, mountPath: /config, readOnly: true }
        - { name: router-client, mountPath: /run/router-client, readOnly: true }
      volumes:
      - name: openclaw-home
        persistentVolumeClaim: { claimName: openclaw-gateway-pvc }
      - name: tmp-volume
        emptyDir: {}
      - name: cache-volume
        emptyDir: {}
      - name: config
        configMap: { name: openclaw-gateway-config }
      - name: ate-api
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels: { podcert.ate.dev/canarying: live }
              path: ca.crt
          - serviceAccountToken:
              audience: api.ate-system.svc
              path: token
      - name: router-client
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels: { podcert.ate.dev/canarying: live }
              path: router-ca.pem
